{
  "outputDirectory": "frontend",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/browse", "destination": "/browse/index.html" },
    { "source": "/about", "destination": "/about/index.html" },
    { "source": "/app", "destination": "/app/index.html" },
    { "source": "/app/commodity", "destination": "/app/commodity/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(css|js|jpg|jpeg|png|svg|webp|woff2?)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
